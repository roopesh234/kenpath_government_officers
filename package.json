{
  "name": "kenpath-government-officers",
  "version": "1.0.0",
  "description": "అధికారి మిత్ర (Adhikari Mitra) - Revenue Officer AI Co-Pilot & Application Disposal Workbench",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "postinstall": "cd client && npm run build",
    "render-build": "npm install && npm run build",
    "build": "cd client && npm run build",
    "start": "node server/server.js",
    "dev": "concurrently -k -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "cd client && npm run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node server/test-endpoints.js"
  },
  "keywords": [
    "andhra-pradesh",
    "telangana",
    "revenue-officer",
    "meeseva",
    "telugu-ai",
    "ai-copilot",
    "sachivalayam"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.1",
    "prettier": "^3.4.2"
  }
}
